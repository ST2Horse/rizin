# Use real code objects: the PYC analysis plugin gets their bounds from the bin loader.
NAME=PYC 2.7: variable instruction lengths and code-object boundaries
FILE=bins/pyc/py27.pyc
CMDS=<<EOF
ao 2 @ 0x2f~address:,bytes:,size:,type:,stackptr:
ao 1 @ 0x33~address:,bytes:,size:,stackptr:
ao 1 @ 0x36~address:,bytes:,size:,type:,stackptr:
af @ 0x1e
afbj @ 0x1e
afij @ 0x1e~{[0].maxbound}
af @ 0x52
afbj @ 0x52
afij @ 0x52~{[0].maxbound}
EOF
EXPECT=<<EOF
address: 0x2f
bytes: 830000
size: 3
type: icall
address: 0x32
bytes: 01
size: 1
type: pop
stackptr: -1
address: 0x33
bytes: 640200
size: 3
stackptr: 1
address: 0x36
bytes: 53
size: 1
type: ret
stackptr: -1
[{"opaddr":30,"addr":30,"size":25,"inputs":0,"outputs":0,"ninstr":11,"traced":false}]
55
[{"opaddr":82,"addr":82,"size":9,"inputs":0,"outputs":0,"ninstr":5,"traced":false}]
91
EOF
REGEXP_FILTER_ERR=<<EOF
free_object\s\(0\)
EOF
EXPECT_ERR=<<EOF
free_object (0)
EOF
RUN

