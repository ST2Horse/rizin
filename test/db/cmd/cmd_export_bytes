NAME=prfa explicit destination offset creates a file with a zero filled gap
FILE=malloc://32
CMDS=<<EOF
wx ff00 @ 0
prfa 0 2 .rz-prfa-gap.bin 4
o .rz-prfa-gap.bin
%v $s
p8 6 @ 0
rm .rz-prfa-gap.bin
EOF
EXPECT=<<EOF
0x6
00000000ff00
EOF
EXPECT_ERR=
RUN

NAME=prf accepts a filename containing spaces
FILE=malloc://32
CMDS=<<EOF
wx 00ff2041 @ 0
prf 0 4 ".rz prf space.bin"
o ".rz prf space.bin"
p8 4 @ 0
rm ".rz prf space.bin"
EOF
EXPECT=<<EOF
00ff2041
EOF
EXPECT_ERR=
RUN

NAME=prf exports across chunk boundaries with numeric expressions
FILE=malloc://8192
CMDS=<<EOF
wx 00ff2041 @ 4094
prf 2-2 4096+2 .rz-prf-chunks.bin
o .rz-prf-chunks.bin
%v $s
p8 4 @ 4094
p8 2 @ 0
rm .rz-prf-chunks.bin
EOF
EXPECT=<<EOF
0x1002
00ff2041
0000
EOF
EXPECT_ERR=
RUN

NAME=prf and prfa help describes raw bytes and destination offsets
FILE=malloc://32
CMDS=<<EOF
prf?~Usage
prfa?~Usage
prfa?~EOF
EOF
EXPECT=<<EOF
Usage: prf <start> <size> <filename>   # Export raw bytes to a file (create or overwrite)
Usage: prfa <start> <size> <filename> [<offset>]   # Export raw bytes to a file (append or write at a file offset)
If offset is omitted, append at EOF. Otherwise, write at that destination file offset, preserving other bytes. An offset beyond EOF creates a zero-filled gap. A missing file is created. A zero size leaves existing bytes and file size unchanged. Only fully readable memory is exported; the current seek and memory are unchanged.
EOF
EXPECT_ERR=
RUN
