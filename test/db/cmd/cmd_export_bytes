NAME=prfa explicit destination offset preserves the rest of the file
FILE=malloc://32
CMDS=<<EOF
wx 11223344556600ff @ 0
prf 0 6 .rz-prfa-offset.bin
prfa 6 2 .rz-prfa-offset.bin 2
prfa 6 1 .rz-prfa-offset.bin 0
o .rz-prfa-offset.bin
