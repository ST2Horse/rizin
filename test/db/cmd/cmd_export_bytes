NAME=prf creates a raw byte file and preserves seek and memory
FILE=malloc://32
CMDS=<<EOF
wx 4100ff204243 @ 4
s 12
prf 4 6 .rz-prf-create.bin
s
p8 6 @ 4
o .rz-prf-create.bin
p8 6 @ 0
rm .rz-prf-create.bin
EOF
EXPECT=<<EOF
0xc
4100ff204243
4100ff204243
EOF
EXPECT_ERR=
RUN

NAME=prf overwrites and truncates an existing file
FILE=malloc://32
CMDS=<<EOF
wx aabbccddeeff @ 0
prf 0 6 .rz-prf-overwrite.bin
prf 2 2 .rz-prf-overwrite.bin
o .rz-prf-overwrite.bin
%v $s
p8 2 @ 0
rm .rz-prf-overwrite.bin
EOF
EXPECT=<<EOF
0x2
ccdd
EOF
EXPECT_ERR=
RUN

